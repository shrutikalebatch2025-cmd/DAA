int max(int a, int b) {
    return (a > b) ? a : b;
}

int knapsack_01(int n, int values[], int weights[], int capacity) {

    int *dp = (int *)calloc(capacity + 1, sizeof(int));


    for (int i = 0; i < n; i++) {

        for (int w = capacity; w >= weights[i]; w--) {
            dp[w] = max(dp[w], values[i] + dp[w - weights[i]]);
        }
    }

    int max_value = dp[capacity];
    free(dp); 
    return max_value;
}

